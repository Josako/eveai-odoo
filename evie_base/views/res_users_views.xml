<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie tab on the user's own Preferences form (My Preferences).
         The core view has a multi-page notebook, so the branding guide's
         mechanism applies: a branded <page name="evie"> tab (the logo
         comes from the shared evie_brand.scss notebook CSS). The language
         preference needs no field here — the native lang field on the
         Preferences tab doubles as the Evie preferred language. -->
    <record id="res_users_preferences_form_evie" model="ir.ui.view">
        <field name="name">res.users.preferences.form.evie</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Evie" name="evie">
                    <group string="Evie Context">
                        <field name="x_evie_booking_page_url" widget="url"
                               readonly="0" placeholder="https://calendly.com/…"/>
                    </group>
                    <group string="Email Signature">
                        <label for="x_evie_email_signature_html" colspan="2"/>
                        <field name="x_evie_email_signature_html" readonly="0"
                               nolabel="1" colspan="2"
                               options="{'codeview': true, 'height': 180, 'resizable': true}"
                               class="border border-secondary"
                               placeholder="Kind regards,&#10;Your name&#10;{{ website }}"/>
                        <label for="x_evie_email_signature_text" colspan="2"/>
                        <field name="x_evie_email_signature_text" readonly="0" rows="6"
                               nolabel="1" colspan="2"
                               placeholder="Kind regards,&#10;Your name&#10;{{ website }}"/>
                        <p class="text-muted" colspan="2">
                            Used only for Email activities sent through Evie.
                            The {{ website }} placeholder becomes your tracked
                            personal website link. Your native Odoo signature
                            is not used or changed.
                        </p>
                    </group>
                    <group string="Synchronisation">
                        <p class="text-muted">
                            Your booking page URL, Evie Email signatures and your
                            language (Preferences tab) are synchronised with Evie —
                            edits in either surface update the other. A language without an entry in the Evie language
                            mapping (Evie ▸ Configuration) is never synchronised.
                        </p>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
