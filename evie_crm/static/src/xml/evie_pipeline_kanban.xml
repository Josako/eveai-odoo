<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <!-- Evie Pipeline lane header: native phase title plus the mapped Odoo
         stage name(s) as a muted subtitle (sales-accepted-phase-funnel-mapping). -->
    <t t-name="evie_crm.EviePipelineKanbanColumn"
       t-inherit="web.KanbanColumn" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kanban_header_title')]" position="after">
            <div t-if="stageSubtitle"
                 class="o_evie_stage_subtitle small text-muted text-truncate"
                 t-att-title="stageSubtitle"
                 t-esc="stageSubtitle"/>
        </xpath>
    </t>
</templates>
