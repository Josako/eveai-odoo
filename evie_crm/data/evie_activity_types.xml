<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie activity types (add-crm-activity-sync).
         Scoped to crm.lead, with distinctive iconography so reps recognise
         them in the activity views. No trigger-based chaining: follow-up
         orchestration is owned by Evie (add-activity-sequences).
         noupdate: tenant edits survive module upgrades. -->
    <data noupdate="1">

        <record id="mail_activity_data_email" model="mail.activity.type">
            <field name="name">Email</field>
            <field name="icon">fa-envelope</field>
            <field name="res_model">crm.lead</field>
        </record>

        <record id="mail_activity_data_note" model="mail.activity.type">
            <field name="name">Note</field>
            <field name="icon">fa-sticky-note</field>
            <field name="res_model">crm.lead</field>
        </record>

        <record id="mail_activity_data_linkedin_connect" model="mail.activity.type">
            <field name="name">LinkedIn Connect</field>
            <field name="icon">fa-linkedin</field>
            <field name="res_model">crm.lead</field>
        </record>

        <record id="mail_activity_data_linkedin_follow_up" model="mail.activity.type">
            <field name="name">LinkedIn Follow-Up</field>
            <field name="icon">fa-linkedin</field>
            <field name="res_model">crm.lead</field>
        </record>

        <record id="mail_activity_data_linkedin_message_in" model="mail.activity.type">
            <field name="name">LinkedIn Message Received</field>
            <field name="icon">fa-linkedin</field>
            <field name="res_model">crm.lead</field>
        </record>

    </data>
</odoo>
