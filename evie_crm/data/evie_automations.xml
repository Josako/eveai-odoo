<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- [AUTO] Evie automation rules. All logic lives in Python model methods;
         these rules only delegate, so behaviour stays versioned and testable. -->

    <!-- Stage change → reverse-translate phase, update anchor, notify Evie -->
    <record id="action_evie_stage_to_phase" model="ir.actions.server">
        <field name="name">[AUTO] Evie: stage → phase</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records.evie_apply_stage_to_phase()</field>
    </record>

    <record id="automation_evie_stage_to_phase" model="base.automation">
        <field name="name">[AUTO] Evie: stage → phase</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(4, ref('crm.field_crm_lead__stage_id'))]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_stage_to_phase'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Inbound sync (add-inbound-odoo-sync): lead lifecycle → Evie.
         The events are hints; Evie reads the record fresh and reconciles
         value-based. All rules respect the echo-guard context flag. -->

    <!-- Lead created → notify Evie (creates the capsule, writes anchor back) -->
    <record id="action_evie_lead_created" model="ir.actions.server">
        <field name="name">[AUTO] Evie: lead upsert (create)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_upsert()</field>
    </record>

    <record id="automation_evie_lead_created" model="base.automation">
        <field name="name">[AUTO] Evie: lead upsert (create)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_lead_created'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Mirrored-field writes + archive/unarchive → notify Evie.
         trigger_field_ids fires once per write, even when several watched
         fields change in one form save (natural debounce). -->
    <record id="action_evie_lead_updated" model="ir.actions.server">
        <field name="name">[AUTO] Evie: lead upsert (write)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_upsert()</field>
    </record>

    <record id="automation_evie_lead_updated" model="base.automation">
        <field name="name">[AUTO] Evie: lead upsert (write)</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_write</field>
        <!-- Keep this list in sync with the mirrored (in/both) fields of
             the active CRM_LEAD_ODOO_CRM mapping — the repo test
             test_odoo_automation_watchlist.py enforces it. -->
        <field name="trigger_field_ids" eval="[
            (4, ref('crm.field_crm_lead__name')),
            (4, ref('crm.field_crm_lead__contact_name')),
            (4, ref('crm.field_crm_lead__email_from')),
            (4, ref('crm.field_crm_lead__phone')),
            (4, ref('crm.field_crm_lead__function')),
            (4, ref('crm.field_crm_lead__partner_name')),
            (4, ref('crm.field_crm_lead__street')),
            (4, ref('crm.field_crm_lead__street2')),
            (4, ref('crm.field_crm_lead__zip')),
            (4, ref('crm.field_crm_lead__city')),
            (4, ref('crm.field_crm_lead__website')),
            (4, ref('crm.field_crm_lead__country_id')),
            (4, ref('crm.field_crm_lead__lang_id')),
            (4, ref('crm.field_crm_lead__team_id')),
            (4, ref('crm.field_crm_lead__user_id')),
            (4, ref('crm.field_crm_lead__active')),
        ]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_lead_updated'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Direct phase edit (e.g. Suspect → Cold Lead after a connection
         request — early phases have no stage) → stage-change channel -->
    <record id="action_evie_phase_edited" model="ir.actions.server">
        <field name="name">[AUTO] Evie: phase edited</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_phase_change()</field>
    </record>

    <record id="automation_evie_phase_edited" model="base.automation">
        <field name="name">[AUTO] Evie: phase edited</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(4, ref('field_crm_lead__x_evie_phase'))]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_phase_edited'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Action completion (odoo-capsule-actions): chatter message when the
         synced action status transitions into DONE/FAILED. The outbound
         sync is hash-diffed, so the rule only fires on real transitions. -->
    <record id="action_evie_action_completed" model="ir.actions.server">
        <field name="name">[AUTO] Evie: action completed</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_action_completed()</field>
    </record>

    <record id="automation_evie_action_completed" model="base.automation">
        <field name="name">[AUTO] Evie: action completed</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[(4, ref('field_crm_lead__x_evie_action_status'))]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_action_completed'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Mapping changes → invalidate Evie-side state.
         Let op: base.automation.action_server_ids is een one2many — elke rule
         heeft zijn eigen action-record nodig (delen 'steelt' de koppeling). -->
    <record id="action_evie_mapping_changed_write" model="ir.actions.server">
        <field name="name">[AUTO] Evie: mapping changed (write)</field>
        <field name="model_id" ref="model_evie_phase_stage_map"/>
        <field name="state">code</field>
        <field name="code">model.evie_notify_mapping_changed()</field>
    </record>

    <record id="action_evie_mapping_changed_unlink" model="ir.actions.server">
        <field name="name">[AUTO] Evie: mapping changed (delete)</field>
        <field name="model_id" ref="model_evie_phase_stage_map"/>
        <field name="state">code</field>
        <field name="code">model.evie_notify_mapping_changed()</field>
    </record>

    <record id="automation_evie_mapping_written" model="base.automation">
        <field name="name">[AUTO] Evie: mapping changed (write)</field>
        <field name="model_id" ref="model_evie_phase_stage_map"/>
        <field name="trigger">on_create_or_write</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_mapping_changed_write'))]"/>
        <field name="active" eval="True"/>
    </record>

    <record id="automation_evie_mapping_unlinked" model="base.automation">
        <field name="name">[AUTO] Evie: mapping changed (delete)</field>
        <field name="model_id" ref="model_evie_phase_stage_map"/>
        <field name="trigger">on_unlink</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_mapping_changed_unlink'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Activity sync (add-crm-activity-sync): lead activities → Evie.
         Events are hints; Evie reads the record fresh (active_test: False,
         so done = archived activities are found, including feedback).
         All rules respect the echo-guard context flag and are scoped to
         activities on crm.lead records. -->

    <!-- Activity created on a lead → notify Evie -->
    <record id="action_evie_activity_created" model="ir.actions.server">
        <field name="name">[AUTO] Evie: activity upsert (create)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_upsert()</field>
    </record>

    <record id="automation_evie_activity_created" model="base.automation">
        <field name="name">[AUTO] Evie: activity upsert (create)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain">[('res_model', '=', 'crm.lead')]</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_activity_created'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Activity written / done (archive writes active=False) → notify Evie.
         trigger_field_ids fires once per write, even when several watched
         fields change in one save (natural debounce). -->
    <record id="action_evie_activity_updated" model="ir.actions.server">
        <field name="name">[AUTO] Evie: activity upsert (write)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_upsert()</field>
    </record>

    <record id="automation_evie_activity_updated" model="base.automation">
        <field name="name">[AUTO] Evie: activity upsert (write)</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_write</field>
        <field name="filter_domain">[('res_model', '=', 'crm.lead')]</field>
        <field name="trigger_field_ids" eval="[
            (4, ref('mail.field_mail_activity__summary')),
            (4, ref('mail.field_mail_activity__note')),
            (4, ref('mail.field_mail_activity__date_deadline')),
            (4, ref('mail.field_mail_activity__user_id')),
            (4, ref('mail.field_mail_activity__activity_type_id')),
            (4, ref('mail.field_mail_activity__active')),
            (4, ref('mail.field_mail_activity__feedback')),
            (4, ref('field_mail_activity__x_evie_final_content')),
        ]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_activity_updated'))]"/>
        <field name="active" eval="True"/>
    </record>

    <!-- Activity cancelled (true unlink) → generic remote-delete channel.
         The record is gone afterwards, so the event carries the remote id
         and the Evie anchor with it. -->
    <record id="action_evie_activity_unlinked" model="ir.actions.server">
        <field name="name">[AUTO] Evie: activity deleted</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_unlinked()</field>
    </record>

    <record id="automation_evie_activity_unlinked" model="base.automation">
        <field name="name">[AUTO] Evie: activity deleted</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_unlink</field>
        <field name="filter_domain">[('res_model', '=', 'crm.lead')]</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_activity_unlinked'))]"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
