<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Show the Evie anchor fields on the lead/opportunity form -->
    <record id="crm_lead_view_form_inherit_evie" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.evie</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <!-- No stat buttons for the research documents (19.0.1.4.0,
                 odoo-capsule-actions): the document reference fields on the
                 Evie tab already open them via the evie_link widget — one
                 clear place beats two. -->
            <xpath expr="//notebook" position="inside">
                <page string="Evie" name="evie">
                    <!-- Evie actions (19.0.1.4.0, odoo-capsule-actions): the
                         widget discovers the configured CRM_LEAD actions
                         live from Evie; x_evie_action_status doubles as the
                         running-state indicator. -->
                    <!-- No x_evie_action_message field on the form: the
                         chatter (automation below) is the natural place for
                         the outcome; the field itself stays for the sync. -->
                    <group string="Actions" name="evie_actions">
                        <field name="x_evie_action_status" nolabel="1"
                               widget="evie_actions"
                               options="{'capsule_type': 'CRM_LEAD'}"/>
                    </group>
                    <!-- Canonical order (crm-sync-polish): Actions → Evie
                         Context → Synchronisation — content before plumbing. -->
                    <group string="Evie Context" name="evie_context">
                        <!-- Editable (add-inbound-odoo-sync): direct phase
                             edits post via the stage-change channel. The other
                             x_evie_* fields stay readonly = Evie-master. -->
                        <field name="x_evie_phase"/>
                        <field name="x_evie_source" readonly="1"/>
                        <!-- Editable + mirrored (crm-sync-polish): rep
                             corrections sync back to Evie, tracked in the
                             chatter. -->
                        <field name="x_evie_linkedin_url" widget="url"/>
                        <!-- Editable + mirrored (crm-sync-polish), like
                             x_evie_phase: rep picks a language, it syncs
                             back as the Evie ISO code. The dropdown offers
                             exactly the languages of evie.language_map
                             (active_test=False: no Odoo-side language
                             activation needed). -->
                        <field name="x_evie_mapped_language_ids" invisible="1"/>
                        <field name="x_evie_language" options="{'no_create': True}"
                               context="{'active_test': False}"
                               domain="[('id', 'in', x_evie_mapped_language_ids)]"/>
                        <field name="x_evie_qualification_score" readonly="1"/>
                        <field name="x_evie_report_doc_version_id" readonly="1"
                               widget="evie_link" options="{'kind': 'document'}"/>
                        <field name="x_evie_rationale_doc_version_id" readonly="1"
                               widget="evie_link" options="{'kind': 'document'}"/>
                    </group>
                    <group string="Synchronisation" name="evie_sync">
                        <field name="x_evie_capsule_id" readonly="1"
                               widget="evie_link" options="{'kind': 'capsule'}"/>
                        <field name="x_evie_last_synced" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
