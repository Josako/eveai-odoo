<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="evie_phase_stage_map_view_list" model="ir.ui.view">
        <field name="name">evie.phase_stage_map.list</field>
        <field name="model">evie.phase_stage_map</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Evie Phase Mapping">
                <field name="sequence" widget="handle"/>
                <field name="phase" readonly="1"/>
                <field name="odoo_type"/>
                <field name="odoo_stage_id"
                       options="{'no_create': True}"
                      />
                <field name="is_default_for_phase"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="evie_phase_stage_map_view_form" model="ir.ui.view">
        <field name="name">evie.phase_stage_map.form</field>
        <field name="model">evie.phase_stage_map</field>
        <field name="arch" type="xml">
            <form string="Evie Phase Mapping">
                <sheet>
                    <group>
                        <field name="phase" readonly="1"/>
                        <field name="odoo_type"/>
                        <field name="odoo_stage_id"
                               options="{'no_create': True}"
                              />
                        <field name="is_default_for_phase"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                    <group string="About">
                        <p class="text-muted">
                            Evie is master over the funnel phase. This mapping translates
                            each stable Evie phase to this database's Odoo type and stage.
                            Stages are referenced by ID, so renaming a stage never breaks
                            the mapping. Leads have no stage; opportunities require one.
                        </p>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="evie_phase_stage_map_action" model="ir.actions.act_window">
        <field name="name">Phase Mapping</field>
        <field name="res_model">evie.phase_stage_map</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                The phase mapping is seeded at install.
            </p>
        </field>
    </record>

    <menuitem id="menu_evie_phase_stage_map"
              name="Phase Mapping"
              parent="evie_base.menu_evie_configuration"
              action="evie_phase_stage_map_action"
              sequence="10"/>
</odoo>
