<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie section on the activity form (popup): branded with the
         evie_brand_header widget (odoo-evie-form-branding) and laid out
         with the canonical Evie groups — Actions, Synchronisation, Evie
         Context — mirroring the lead's Evie tab. The activity popup has
         no core notebook, and Odoo hides a single tab, so the branded
         tab trick from crm.lead is unavailable here. -->
    <record id="mail_activity_view_form_popup_evie" model="ir.ui.view">
        <field name="name">mail.activity.view.form.popup.evie</field>
        <field name="model">mail.activity</field>
        <field name="inherit_id" ref="mail.mail_activity_view_form_popup"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='note']" position="after">
                <!-- Branded header: recognisably Evie, same visual weight
                     as the branded notebook tab on crm.lead. Hidden unless
                     the activity is Evie-linked, like the groups below. -->
                <widget name="evie_brand_header" title="EVIE"
                        invisible="not x_evie_capsule_id and not x_evie_activity_type"/>
                <!-- Evie actions (sync-activity-proposal-to-odoo): the
                     evie_actions widget renders the configured capsule
                     actions (e.g. Generate Proposal) and doubles as the
                     running-state indicator via x_evie_action_status. Own
                     group, like on the lead form: inline in a two-column
                     group the button row breaks the grid layout of the
                     following fields. -->
                <group string="Actions" name="evie_actions" colspan="2"
                       invisible="not x_evie_capsule_id">
                    <field name="x_evie_action_status" nolabel="1" colspan="2"
                           widget="evie_actions"
                           options="{'capsule_type': 'CRM_ACTIVITY'}"/>
                    <field name="x_evie_action_message" readonly="1" colspan="2"
                           invisible="not x_evie_action_message"/>
                </group>
                <!-- Synchronisation: the capsule reference and the last
                     push-sync timestamp — same contents as the lead's
                     Synchronisation group. -->
                <group string="Synchronisation" name="evie_sync" colspan="2"
                       invisible="not x_evie_capsule_id and not x_evie_activity_type">
                    <field name="x_evie_capsule_id" readonly="1"
                           widget="evie_link" options="{'kind': 'capsule'}"/>
                    <field name="x_evie_last_synced" readonly="1"/>
                </group>
                <!-- Evie Context: the remaining Evie-master fields plus the
                     rep-editable outcome (add-activity-sequences): the rep
                     sets the outcome before marking the activity done; the
                     key syncs to Evie with the completion. Editable,
                     optional — like x_evie_phase in the lead's context. -->
                <group string="Evie Context" name="evie_context" colspan="2"
                       invisible="not x_evie_capsule_id and not x_evie_activity_type">
                    <field name="x_evie_activity_type" readonly="1"/>
                    <field name="x_evie_outcome"/>
                </group>
                <!-- Proposal content: two separate fields so the rep sees
                     both the specialist's original draft and the final
                     text (design D2). The final field is EDITABLE (Odoo is
                     the rep's playground) and always visible on Evie-linked
                     activities: the rep must be able to write or adjust
                     the final text even when no specialist draft exists. -->
                <group string="Evie proposal (final — editable)" colspan="2"
                       invisible="not x_evie_capsule_id">
                    <field name="x_evie_final_content" nolabel="1"
                           colspan="2"
                           placeholder="Write or adjust the final proposal here — it syncs back to Evie…"/>
                </group>
                <group string="Original proposal (specialist draft)" colspan="2"
                       invisible="not x_evie_proposed_content or (x_evie_final_content and x_evie_proposed_content == x_evie_final_content)">
                    <field name="x_evie_proposed_content" readonly="1" nolabel="1"
                           colspan="2"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
