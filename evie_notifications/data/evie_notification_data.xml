<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hourly so every user gets the digest shortly after 07:00 in their
         own timezone; the dedupe key keeps it to one per user per day. -->
    <record id="cron_evie_notification_activity_digest" model="ir.cron">
        <field name="name">Evie: daily activity digest notifications</field>
        <field name="model_id" ref="model_evie_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_activity_digest()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_evie_notification_cleanup" model="ir.cron">
        <field name="name">Evie: remove old notifications</field>
        <field name="model_id" ref="model_evie_notification"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <data noupdate="1">
        <record id="param_evie_notification_retention_days" model="ir.config_parameter">
            <field name="key">evie_notifications.retention_days</field>
            <field name="value">90</field>
        </record>
    </data>
</odoo>
