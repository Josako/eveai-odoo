<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Users only ever see their own notifications. Changes (read, clear)
         go through the model's bell methods, which scope to the current
         user and write with sudo. -->
    <record id="rule_evie_notification_own" model="ir.rule">
        <field name="name">Evie notifications: own only</field>
        <field name="model_id" ref="model_evie_notification"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_evie_notification_system" model="ir.rule">
        <field name="name">Evie notifications: administrators see all</field>
        <field name="model_id" ref="model_evie_notification"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
    </record>
</odoo>
