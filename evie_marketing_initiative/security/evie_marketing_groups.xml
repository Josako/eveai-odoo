<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie Marketing groups: initiatives, channels, forms and captures
         are a marketing responsibility; captures are shared with sales
         (decision fields). The integration user gets the manager group
         (least privilege: create on mirror models only, not on sales
         data). Create permissions are access-level future-proofing —
         actual Odoo-side creation stays guarded by the capsule-link
         mixin until Odoo-originated creation is built (Gitea #64). -->
    <!-- Odoo 19: res.groups has no category_id — groups hang under a
         res.groups.privilege (the app-level entry in user settings),
         which itself carries the module category. Same pattern as
         mass_mailing's "Email Marketing" privilege. -->
    <record id="res_groups_privilege_evie_marketing" model="res.groups.privilege">
        <field name="name">Evie Marketing</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="base.module_category_marketing"/>
    </record>

    <record id="group_evie_marketing_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_evie_marketing"/>
    </record>

    <record id="group_evie_marketing_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_evie_marketing"/>
        <field name="implied_ids" eval="[(4, ref('group_evie_marketing_user'))]"/>
    </record>
</odoo>
