<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie Marketing menus. The evie_base root is admin-only; the
         marketing surface is for marketing and sales users, so it gets
         its own root. The marketing manager sees it via group
         implication on group_evie_marketing_user. -->
    <menuitem id="menu_evie_marketing_root"
              name="Evie Marketing"
              sequence="99"
              groups="sales_team.group_sale_salesman,evie_marketing_initiative.group_evie_marketing_user"
              web_icon="evie_base,static/src/img/evie.svg"/>

    <menuitem id="menu_evie_marketing_initiatives"
              name="Initiatives"
              parent="menu_evie_marketing_root"
              action="action_marketing_initiative"
              sequence="10"/>

    <menuitem id="menu_evie_marketing_channels"
              name="Channels"
              parent="menu_evie_marketing_root"
              action="action_marketing_channel"
              sequence="20"/>

    <menuitem id="menu_evie_marketing_captures"
              name="Captures"
              parent="menu_evie_marketing_root"
              action="action_marketing_capture"
              sequence="30"/>

    <menuitem id="menu_evie_marketing_capture_forms"
              name="Capture Forms"
              parent="menu_evie_marketing_root"
              action="action_marketing_capture_form"
              sequence="40"/>
</odoo>
