<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- marketing.initiative: mirror of MARKETING_INITIATIVE capsules.
         New model without a core notebook → the evie_brand_header widget
         carries the branding (odoo-evie-ui-branding). Section order:
         result tiles → Actions → definition → notebook, with the
         synchronisation plumbing in the branded Evie tab (same as the
         lead). -->

    <record id="marketing_initiative_view_form" model="ir.ui.view">
        <field name="name">marketing.initiative.form</field>
        <field name="model">marketing.initiative</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Capture list popup (capture-list-view): view and
                         process this initiative's captures in Evie. -->
                    <button name="action_open_capture_list" type="object"
                            string="Captures" class="oe_highlight"
                            invisible="not capsule_id"
                            title="View and process this initiative's captures in Evie"/>
                </header>
                <sheet>
                    <!-- Failed-create notice (odoo-marketing-mirror-create):
                         only rendered in error state — accurate whenever the
                         form (re)loads; the chatter carries the reason. No
                         pending banner: a statically rendered banner shows
                         before the first save and never auto-clears, so the
                         sync_state badge in the Synchronisation section is
                         the state indicator. -->
                    <div class="alert alert-danger" role="alert"
                         invisible="sync_state != 'error'">
                        <i class="fa fa-exclamation-triangle" title="Synchronisation error"/>
                        Evie could not create this initiative — see the chatter for details.
                        Correct the values and save to retry.
                    </div>
                    <widget name="evie_brand_header" title="EVIE MARKETING"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Initiative name"/></h1>
                    </div>
                    <div class="o_evie_kpis">
                        <div class="o_evie_kpi">
                            <span class="o_evie_kpi__label">Captures</span>
                            <field name="capture_count" class="o_evie_kpi__value"/>
                        </div>
                        <div class="o_evie_kpi">
                            <span class="o_evie_kpi__label">Leads</span>
                            <field name="lead_count" class="o_evie_kpi__value"/>
                        </div>
                        <div class="o_evie_kpi">
                            <span class="o_evie_kpi__label">Cost per capture</span>
                            <field name="cost_per_capture" class="o_evie_kpi__value"/>
                        </div>
                        <div class="o_evie_kpi">
                            <span class="o_evie_kpi__label">ROI</span>
                            <field name="roi" class="o_evie_kpi__value"/>
                        </div>
                    </div>
                    <group string="Actions" name="evie_actions" class="o_evie_card"
                           invisible="not capsule_id">
                        <field name="sync_state" nolabel="1"
                               widget="evie_actions"
                               options="{'capsule_type': 'MARKETING_INITIATIVE', 'capsule_id_field': 'capsule_id'}"/>
                    </group>
                    <group class="o_evie_card">
                        <group string="Definition">
                            <field name="code"/>
                            <field name="type"/>
                            <field name="state"/>
                            <field name="user_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="location"/>
                            <field name="country_id"/>
                        </group>
                        <group string="Budget &amp; Costs">
                            <field name="budget"/>
                            <field name="currency_id"/>
                            <field name="actual_cost"/>
                            <field name="attribution_days"/>
                        </group>
                    </group>
                    <group string="Description" colspan="2">
                        <field name="description" nolabel="1"/>
                    </group>
                    <notebook colspan="2">
                        <page string="Cost Lines" name="cost_lines">
                            <field name="cost_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Channels" name="channels">
                            <!-- Explicit inline columns (odoo-capture-card-view,
                                 design D4): without an inline arch the mobile
                                 client falls back to display-name-only rows. -->
                            <field name="channel_ids" nolabel="1">
                                <list>
                                    <field name="name"/>
                                    <field name="channel_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Captures" name="captures">
                            <!-- Date + state carry the row while the contact
                                 name is still empty pending review — never a
                                 blank line on mobile. -->
                            <field name="capture_ids" nolabel="1">
                                <list>
                                    <field name="captured_at"/>
                                    <field name="name"/>
                                    <!-- Channel attribution per capture
                                         (capture-lifecycle-actions). -->
                                    <field name="channel_id" readonly="1"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Leads" name="leads">
                            <field name="lead_ids" nolabel="1">
                                <list>
                                    <!-- crm.lead.name is labelled 'Opportunity'
                                         standard Odoo; this marketing context
                                         shows leads (fix-marketing-capture-lifecycle). -->
                                    <field name="name" string="Lead"/>
                                    <!-- Which channel produced this lead
                                         (capture-lifecycle-actions); the
                                         field syncs already via the
                                         CAPTURE_GENERATED_LEAD chain. -->
                                    <field name="initiative_channel_id" readonly="1"/>
                                    <field name="partner_name" readonly="1"/>
                                    <field name="expected_revenue" readonly="1"/>
                                    <field name="stage_id" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="UTM" name="utm">
                            <group string="UTM Strategy" class="o_evie_card">
                                <group>
                                    <field name="utm_campaign"/>
                                    <field name="utm_medium"/>
                                </group>
                                <group>
                                    <field name="utm_term"/>
                                    <field name="utm_content"/>
                                </group>
                            </group>
                            <group string="UTM Records (materialised)"
                                   class="o_evie_card o_evie_card--muted">
                                <group>
                                    <field name="campaign_id"/>
                                </group>
                                <group>
                                    <field name="medium_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Evie" name="evie">
                            <group string="Synchronisation" name="evie_sync"
                                   class="o_evie_card o_evie_card--muted">
                                <group>
                                    <field name="capsule_id" widget="evie_link"
                                           invisible="not capsule_id"
                                           options="{'kind': 'capsule'}"/>
                                    <field name="capsule_version"
                                           invisible="not capsule_id"/>
                                </group>
                                <group>
                                    <field name="sync_state" widget="badge"/>
                                    <field name="last_sync_date"
                                           invisible="not capsule_id"/>
                                    <field name="local_dirty"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="marketing_initiative_view_list" model="ir.ui.view">
        <field name="name">marketing.initiative.list</field>
        <field name="model">marketing.initiative</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="type"/>
                <field name="state" widget="badge"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="user_id"/>
                <field name="budget"/>
                <field name="actual_cost"/>
                <field name="sync_state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="marketing_initiative_view_kanban" model="ir.ui.view">
        <field name="name">marketing.initiative.kanban</field>
        <field name="model">marketing.initiative</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state">
                <field name="name"/>
                <field name="state"/>
                <field name="date_start"/>
                <field name="budget"/>
                <field name="capture_count"/>
                <field name="lead_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_content">
                            <strong><field name="name"/></strong>
                            <div><field name="state" widget="badge"/></div>
                            <div><i class="fa fa-calendar" title="Start date"/> <field name="date_start"/></div>
                            <div>
                                <i class="fa fa-clipboard" title="Captures"/> <field name="capture_count"/> captures ·
                                <i class="fa fa-bullseye" title="Leads"/> <field name="lead_count"/> leads
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="marketing_initiative_view_search" model="ir.ui.view">
        <field name="name">marketing.initiative.search</field>
        <field name="model">marketing.initiative</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="location"/>
                <filter name="state_active" string="Active"
                        domain="[('state', '=', 'active')]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_state" string="State"
                        context="{'group_by': 'state'}"/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'type'}"/>
                <filter name="group_owner" string="Owner"
                        context="{'group_by': 'user_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_marketing_initiative" model="ir.actions.act_window">
        <field name="name">Marketing Initiatives</field>
        <field name="res_model">marketing.initiative</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
