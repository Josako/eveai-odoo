<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- evie.marketing.type.map: tenant administration of the marketing
         type keys feeding the initiative/channel dropdowns
         (odoo-marketing-mirror-create, D3b). Manager-only — the keys must
         match the Evie dynamic lists, so this is a configuration surface,
         not a daily-use one. -->

    <record id="evie_marketing_type_map_view_list" model="ir.ui.view">
        <field name="name">evie.marketing.type.map.list</field>
        <field name="model">evie.marketing.type.map</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="kind"/>
                <field name="evie_key"/>
                <field name="label"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="evie_marketing_type_map_view_form" model="ir.ui.view">
        <field name="name">evie.marketing.type.map.form</field>
        <field name="model">evie.marketing.type.map</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="kind"/>
                        <field name="evie_key"/>
                        <field name="label"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group colspan="2">
                        <div class="alert alert-info" role="status">
                            The Evie key must match a key of the
                            corresponding Evie dynamic list
                            (MARKETING_INITIATIVE_TYPE or
                            MARKETING_CHANNEL_TYPE). The stored value on
                            initiatives and channels is always the key,
                            never the label.
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_evie_marketing_type_map" model="ir.actions.act_window">
        <field name="name">Marketing Type Mapping</field>
        <field name="res_model">evie.marketing.type.map</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
