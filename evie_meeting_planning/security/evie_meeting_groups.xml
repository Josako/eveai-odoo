<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evie Meeting Planning groups: the meeting library (templates and
         objective templates) is curated by managers; plans and
         objectives are rep work. The integration user gets the manager
         group (least privilege: create on mirror models only). Odoo 19:
         groups hang under a res.groups.privilege (the app-level entry in
         user settings) — same pattern as evie_marketing_initiative. -->
    <record id="res_groups_privilege_evie_meeting" model="res.groups.privilege">
        <field name="name">Evie Meeting Planning</field>
        <field name="sequence">21</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_evie_meeting_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_evie_meeting"/>
    </record>

    <record id="group_evie_meeting_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_evie_meeting"/>
        <field name="implied_ids" eval="[(4, ref('group_evie_meeting_user'))]"/>
    </record>
</odoo>
