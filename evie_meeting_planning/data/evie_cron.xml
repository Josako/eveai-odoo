<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- local_dirty retry queue: edits made while Evie was unreachable
         are re-notified until the write-back lands. One cron per
         editable mirror model. -->
    <record id="cron_evie_objective_template_retry_dirty" model="ir.cron">
        <field name="name">Evie: retry objective template write-backs (local_dirty)</field>
        <field name="model_id" ref="model_objective_template"/>
        <field name="state">code</field>
        <field name="code">model.evie_retry_local_dirty()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_evie_meeting_template_retry_dirty" model="ir.cron">
        <field name="name">Evie: retry meeting template write-backs (local_dirty)</field>
        <field name="model_id" ref="model_meeting_template"/>
        <field name="state">code</field>
        <field name="code">model.evie_retry_local_dirty()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_evie_meeting_plan_retry_dirty" model="ir.cron">
        <field name="name">Evie: retry meeting plan write-backs (local_dirty)</field>
        <field name="model_id" ref="model_meeting_plan"/>
        <field name="state">code</field>
        <field name="code">model.evie_retry_local_dirty()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_evie_meeting_objective_retry_dirty" model="ir.cron">
        <field name="name">Evie: retry meeting objective write-backs (local_dirty)</field>
        <field name="model_id" ref="model_meeting_objective"/>
        <field name="state">code</field>
        <field name="code">model.evie_retry_local_dirty()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
