    <record id="action_evie_meeting_objective_created" model="ir.actions.server">
        <field name="name">[AUTO] Evie: meeting objective upsert (create)</field>
        <field name="model_id" ref="model_meeting_objective"/>
        <field name="state">code</field>
        <field name="code">records.evie_notify_upsert()</field>
    </record>

    <record id="automation_evie_meeting_objective_created" model="base.automation">
        <field name="name">[AUTO] Evie: meeting objective upsert (create)</field>
        <field name="model_id" ref="model_meeting_objective"/>
        <field name="trigger">on_create</field>
        <field name="action_server_ids" eval="[(4, ref('action_evie_meeting_objective_created'))]"/>
        <field name="active" eval="True"/>
    </record>

    <record id="automation_evie_meeting_objective_updated" model="base.automation">
        <field name="name">[AUTO] Evie: meeting objective upsert (write)</field>
        <field name="model_id" ref="model_meeting_objective"/>
        <field name="trigger">on_write</field>
        <field name="trigger_field_ids" eval="[
            (4, ref('field_meeting_objective__name')),
            (4, ref('field_meeting_objective__objective_type')),
            (4, ref('field_meeting_objective__intent')),
            (4, ref('field_meeting_objective__success_criterion')),
            (4, ref('field_meeting_objective__guiding_questions')),
            (4, ref('field_meeting_objective__dimensions')),
            (4, ref('field_meeting_objective__priority')),
            (4, ref('field_meeting_objective__rep_note')),
            (4, ref('field_meeting_objective__context_note')),
            (4, ref('field_meeting_objective__active')),
        ]"/>
        <field name="action_server_ids" eval="[(4, ref('action_evie_meeting_objective_updated'))]"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
